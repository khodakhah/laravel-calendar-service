{
  "title": "Calendar",
  "description": "A calendar resource used to group events, availability, and scheduling context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "owner_id",
    "type",
    "timezone"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary key of the calendar.",
      "example": "6c6b8f0a-6cf6-4db4-9f86-3a2f51571310"
    },
    "name": {
      "type": "string",
      "description": "Human-readable calendar name.",
      "example": "Engineering Team Calendar",
      "maxLength": 255
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "description": "External owner reference stored as a UUID.",
      "example": "f7a8dbec-6201-4f06-a383-2a7f8ee6dd45"
    },
    "type": {
      "type": "string",
      "description": "Calendar category, such as work, personal, or resource_booking.",
      "example": "work"
    },
    "timezone": {
      "type": "string",
      "description": "Default IANA timezone context for this calendar.",
      "example": "Europe/Berlin"
    },
    "working_hours": {
      "type": "array",
      "description": "Default weekly working hours for this calendar, interpreted in the calendar timezone.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day_of_week",
          "start_time",
          "end_time"
        ],
        "properties": {
          "day_of_week": {
            "type": "string",
            "description": "Day of the week for this working-hours rule.",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ],
            "example": "monday"
          },
          "start_time": {
            "type": "string",
            "description": "Daily start time in 24-hour HH:MM format.",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "09:00"
          },
          "end_time": {
            "type": "string",
            "description": "Daily end time in 24-hour HH:MM format.",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "17:00"
          }
        }
      },
      "example": [
        {
          "day_of_week": "monday",
          "start_time": "09:00",
          "end_time": "17:00"
        },
        {
          "day_of_week": "tuesday",
          "start_time": "09:00",
          "end_time": "17:00"
        }
      ]
    },
    "blocked_times": {
      "type": "array",
      "description": "Special blocked periods that override normal availability, such as vacation, holidays, maintenance, or construction.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "starts_at",
          "ends_at",
          "reason"
        ],
        "properties": {
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the blocked period in ISO 8601 format.",
            "example": "2026-07-01T00:00:00+02:00"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "description": "End of the blocked period in ISO 8601 format.",
            "example": "2026-07-10T23:59:59+02:00"
          },
          "reason": {
            "type": "string",
            "description": "Human-readable explanation for the blocked period.",
            "example": "vacation",
            "maxLength": 255
          },
          "notes": {
            "type": "string",
            "description": "Optional extra context for the blocked period.",
            "example": "Office closed for annual summer break."
          }
        }
      },
      "example": [
        {
          "starts_at": "2026-07-01T00:00:00+02:00",
          "ends_at": "2026-07-10T23:59:59+02:00",
          "reason": "vacation",
          "notes": "Office closed for annual summer break."
        },
        {
          "starts_at": "2026-08-15T08:00:00+02:00",
          "ends_at": "2026-08-20T18:00:00+02:00",
          "reason": "construction",
          "notes": "Meeting room unavailable during renovation."
        }
      ]
    }
  }
}
